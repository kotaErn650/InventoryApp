<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="InventoryApp.Views.ProveedoresPage"
             Title="Organizadores"
             BackgroundColor="{StaticResource Gray100}">

    <Grid RowDefinitions="Auto,*,Auto">

        <Button Grid.Row="0"
                Text="➕ Nuevo organizador"
                Command="{Binding NewCommand}"
                BackgroundColor="#F97316"
                TextColor="White"
                Margin="15,14,15,10"/>

        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Proveedores}"
                        Margin="12,0">

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,6"
                            Padding="14"
                            BackgroundColor="White"
                            Stroke="#E2E8F0"
                            StrokeShape="RoundRectangle 18">

                        <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="80,*">

                            <Image Grid.Row="0" Grid.Column="0" Grid.RowSpan="3"
                                   Source="{Binding Foto}"
                                   WidthRequest="70"
                                   HeightRequest="70"
                                   Aspect="AspectFill"
                                   VerticalOptions="Center">
                                <Image.Clip>
                                    <EllipseGeometry Center="35,35" RadiusX="35" RadiusY="35"/>
                                </Image.Clip>
                            </Image>

                            <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="3" Padding="12,0,0,0">

                                <Label Text="{Binding Nombre}"
                                       FontSize="17"
                                       FontAttributes="Bold"/>

                                <Label Text="{Binding TipoProducto, StringFormat='Especialidad: {0}'}"
                                       FontSize="13"
                                       TextColor="#64748B"/>

                                <Label Text="{Binding Activo, Converter={StaticResource BoolToEstadoConverter}}"
                                       FontAttributes="Bold"
                                       FontSize="13"/>

                            </VerticalStackLayout>

                            <Grid Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                                  ColumnDefinitions="*,Auto,Auto"
                                  Margin="0,8,0,0">

                                <Label Grid.Column="0"
                                       Text="{Binding Telefono, StringFormat='📞 {0}'}"
                                       FontSize="12"
                                       TextColor="#64748B"
                                       VerticalOptions="Center"/>

                                <Button Grid.Column="1"
                                        Text="✏️ Editar"
                                        FontSize="12"
                                        HeightRequest="36"
                                        Padding="10,0"
                                        BackgroundColor="#FFF7ED"
                                        TextColor="#C2410C"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.EditCommand}"
                                        CommandParameter="{Binding .}"/>

                                <Button Grid.Column="2"
                                        Text="{Binding Activo, Converter={StaticResource BoolToToggleTextConverter}}"
                                        BackgroundColor="{Binding Activo, Converter={StaticResource BoolToToggleColorConverter}}"
                                        TextColor="White"
                                        FontSize="12"
                                        HeightRequest="36"
                                        Padding="10,0"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ToggleActivoCommand}"
                                        CommandParameter="{Binding .}"/>

                            </Grid>

                        </Grid>

                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

        <Grid Grid.Row="2"
              BackgroundColor="#0F172A"
              Padding="10"
              ColumnDefinitions="*,*,*,*">

            <Button Grid.Column="0"
                    Text="🏠 Inicio"
                    BackgroundColor="Transparent"
                    TextColor="#F8FAFC"
                    Command="{Binding GoInicioCommand}"/>

            <Button Grid.Column="1"
                    Text="🎟️ Eventos"
                    BackgroundColor="Transparent"
                    TextColor="#A78BFA"
                    Command="{Binding GoProductsCommand}"/>

            <Button Grid.Column="2"
                    Text="🤝 Organizadores"
                    BackgroundColor="Transparent"
                    TextColor="#FDBA74"
                    Command="{Binding GoProveedoresCommand}"/>

            <Button Grid.Column="3"
                    Text="✨ Marca"
                    BackgroundColor="Transparent"
                    TextColor="#22D3EE"/>

        </Grid>

    </Grid>

</ContentPage>
