<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:InventoryApp.Models"
             x:Class="InventoryApp.Views.EventsPage"
             Title="Eventos">

    <Shell.SearchHandler>
        <SearchHandler Placeholder="Buscar eventos"
                       Query="{Binding SearchText, Mode=TwoWay}"
                       ItemsSource="{Binding Events}"
                       SearchBoxVisibility="Expanded"
                       ShowsResults="True">
            <SearchHandler.ItemTemplate>
                <DataTemplate x:DataType="models:ConcertEvent">
                    <Grid Padding="12,8" RowDefinitions="Auto,Auto">
                        <Label Text="{Binding Titulo}" FontAttributes="Bold" FontSize="14" />
                        <Label Grid.Row="1"
                               Text="{Binding Artista}"
                               FontSize="12"
                               TextColor="Gray" />
                    </Grid>
                </DataTemplate>
            </SearchHandler.ItemTemplate>
        </SearchHandler>
    </Shell.SearchHandler>

    <Grid RowDefinitions="Auto,*,Auto">
        <Button Grid.Row="0"
                Text="+ Nuevo evento"
                Command="{Binding NewCommand}"
                Margin="15,10" />

        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Events}"
                        Margin="10,0">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:ConcertEvent">
                    <Border Margin="0,5" Padding="14" StrokeShape="RoundRectangle 10">
                        <VerticalStackLayout Spacing="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="{Binding Titulo}" FontSize="18" FontAttributes="Bold" />
                                    <Label Text="{Binding Artista}" FontSize="14" TextColor="Gray" />
                                </VerticalStackLayout>
                                <Border Padding="10,4" BackgroundColor="#EAF3FF" StrokeThickness="0" StrokeShape="RoundRectangle 999">
                                    <Label Text="{Binding Estado}" FontSize="12" TextColor="#1F4E8C" />
                                </Border>
                            </Grid>

                            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12">
                                <Label Text="{Binding Lugar, StringFormat='📍 {0}'}" />
                                <Label Grid.Column="1" Text="{Binding Ciudad, StringFormat='🌆 {0}'}" />
                                <Label Grid.Row="1" Text="{Binding FechaEvento, StringFormat='🗓 {0:dd MMM yyyy}'}" />
                                <Label Grid.Row="1" Grid.Column="1" Text="{Binding PrecioEntrada, StringFormat='🎟 ${0:N0}'}" />
                            </Grid>

                            <Label Text="{Binding Descripcion}"
                                   FontSize="13"
                                   TextColor="Gray" />

                            <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,4,0,0">
                                <Label Text="{Binding Capacidad, StringFormat='Capacidad: {0} personas'}"
                                       VerticalOptions="Center" />
                                <Button Grid.Column="1"
                                        Text="Editar"
                                        FontSize="12"
                                        HeightRequest="36"
                                        Padding="10,0"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.EditCommand}"
                                        CommandParameter="{Binding .}" />
                                <Button Grid.Column="2"
                                        Text="Destacar"
                                        FontSize="12"
                                        HeightRequest="36"
                                        Padding="10,0"
                                        BackgroundColor="#5B8DEF"
                                        TextColor="White"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ToggleFeaturedCommand}"
                                        CommandParameter="{Binding .}" />
                            </Grid>

                            <Label Text="{Binding Destacado, StringFormat='Evento destacado: {0}'}"
                                   FontSize="12"
                                   TextColor="#5B8DEF" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Grid Grid.Row="2"
              BackgroundColor="#191919"
              Padding="10"
              ColumnDefinitions="*,*,*,*">
            <Button Grid.Column="0"
                    Text="Inicio"
                    BackgroundColor="Transparent"
                    TextColor="#00FFFF"
                    Command="{Binding GoInicioCommand}" />
            <Button Grid.Column="1"
                    Text="Eventos"
                    BackgroundColor="Transparent"
                    TextColor="#FF10F0"
                    Command="{Binding GoEventsCommand}" />
            <Button Grid.Column="2"
                    Text="Artistas"
                    BackgroundColor="Transparent"
                    TextColor="#FFA500"
                    Command="{Binding GoArtistsCommand}" />
            <Button Grid.Column="3"
                    Text="Operación"
                    BackgroundColor="Transparent"
                    TextColor="#39FF14"
                    Command="{Binding GoSettingsCommand}" />
        </Grid>
    </Grid>
</ContentPage>
