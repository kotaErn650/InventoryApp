<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="InventoryApp.Views.ProductFormPage"
             Title="{Binding Title}"
             BackgroundColor="{StaticResource Gray100}">
    <Grid RowDefinitions="*,Auto">

        <ScrollView Grid.Row="0">

            <VerticalStackLayout Padding="20" Spacing="12">

                <Border StrokeThickness="0"
                        BackgroundColor="#1E1B4B"
                        StrokeShape="RoundRectangle 22"
                        Padding="18">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="🎟️ Detalle del evento" FontSize="22" FontAttributes="Bold" TextColor="White"/>
                        <Label Text="Configura nombre, descripción, precio y cupos disponibles para publicación."
                               FontSize="14"
                               TextColor="#CBD5E1"/>
                    </VerticalStackLayout>
                </Border>

                <Label Text="Nombre del evento" FontAttributes="Bold"/>
                <Entry Placeholder="Ej. Festival de verano"
                       Text="{Binding Nombre}"/>

                <Label Text="Descripción" FontAttributes="Bold"/>
                <Editor Placeholder="Describe la experiencia, invitados o agenda"
                        HeightRequest="100"
                        Text="{Binding Descripcion}"/>

                <Label Text="Precio de entrada" FontAttributes="Bold"/>
                <Entry Placeholder="0.00"
                       Keyboard="Numeric"
                       Text="{Binding Precio}"/>

                <Label Text="Cupos disponibles" FontAttributes="Bold"/>
                <Entry Placeholder="0"
                       Keyboard="Numeric"
                       Text="{Binding Stock}"/>

                <Label Text="Estado de publicación" FontAttributes="Bold"/>
                <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                    <Label Grid.Column="0"
                           Text="{Binding Activo, Converter={StaticResource BoolToEstadoConverter}}"
                           VerticalOptions="Center"
                           FontSize="14"/>
                    <Switch Grid.Column="1"
                            IsToggled="{Binding Activo}"
                            VerticalOptions="Center"/>
                </Grid>

                <Button Text="💾 Guardar evento"
                        Command="{Binding SaveCommand}"
                        HeightRequest="50"
                        BackgroundColor="#7C3AED"
                        TextColor="White"
                        Margin="0,10,0,0"/>

            </VerticalStackLayout>

        </ScrollView>

        <Grid Grid.Row="1"
              BackgroundColor="#0F172A"
              Padding="10"
              ColumnDefinitions="*,*,*,*">

            <Button Grid.Column="0"
                    Text="🏠 Inicio"
                    BackgroundColor="Transparent"
                    TextColor="#F8FAFC"
                    Command="{Binding GoInicioCommand}"/>

            <Button Grid.Column="1"
                    Text="🎟️ Eventos"
                    BackgroundColor="Transparent"
                    TextColor="#A78BFA"
                    Command="{Binding GoProductsCommand}"/>

            <Button Grid.Column="2"
                    Text="🤝 Organizadores"
                    BackgroundColor="Transparent"
                    TextColor="#FDBA74"
                    Command="{Binding GoProveedoresCommand}"/>

            <Button Grid.Column="3"
                    Text="HelpSopor"
                    BackgroundColor="Transparent"
                    TextColor="#39FF14"
                    Command="{Binding GoConfiguracionCommand}"/>

        </Grid>

    </Grid>
</ContentPage>
