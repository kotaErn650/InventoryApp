<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:InventoryApp.Models"
             x:Class="InventoryApp.Views.ArtistsPage"
             Title="Artistas">

    <Shell.SearchHandler>
        <SearchHandler Placeholder="Buscar artistas"
                       Query="{Binding SearchText, Mode=TwoWay}"
                       ItemsSource="{Binding Artists}"
                       SearchBoxVisibility="Expanded"
                       ShowsResults="True">
            <SearchHandler.ItemTemplate>
                <DataTemplate x:DataType="models:Artist">
                    <Grid Padding="12,8" RowDefinitions="Auto,Auto">
                        <Label Text="{Binding Nombre}" FontAttributes="Bold" FontSize="14" />
                        <Label Grid.Row="1"
                               Text="{Binding Genero}"
                               FontSize="12"
                               TextColor="Gray" />
                    </Grid>
                </DataTemplate>
            </SearchHandler.ItemTemplate>
        </SearchHandler>
    </Shell.SearchHandler>

    <Grid RowDefinitions="Auto,*,Auto">
        <Button Grid.Row="0"
                Text="+ Nuevo artista"
                Command="{Binding NewCommand}"
                Margin="15,10" />

        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Artists}"
                        Margin="10,0">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Artist">
                    <Border Margin="0,5" Padding="12" StrokeShape="RoundRectangle 8">
                        <VerticalStackLayout Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="{Binding Nombre}" FontSize="17" FontAttributes="Bold" />
                                    <Label Text="{Binding Genero, StringFormat='Género: {0}'}"
                                           FontSize="13"
                                           TextColor="Gray" />
                                </VerticalStackLayout>
                                <Label Text="{Binding Activo, Converter={StaticResource BoolToEstadoConverter}}"
                                       FontAttributes="Bold"
                                       FontSize="13"
                                       VerticalOptions="Center" />
                            </Grid>

                            <Label Text="{Binding Manager, StringFormat='Manager: {0}'}" FontSize="13" />
                            <Label Text="{Binding Telefono, StringFormat='📞 {0}'}" FontSize="12" TextColor="Gray" />
                            <Label Text="{Binding Email, StringFormat='✉️ {0}'}" FontSize="12" TextColor="Gray" />

                            <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,6,0,0">
                                <Label Text="Disponible para programación"
                                       FontSize="12"
                                       VerticalOptions="Center" />
                                <Button Grid.Column="1"
                                        Text="Editar"
                                        FontSize="12"
                                        HeightRequest="36"
                                        Padding="10,0"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.EditCommand}"
                                        CommandParameter="{Binding .}" />
                                <Button Grid.Column="2"
                                        Text="{Binding Activo, Converter={StaticResource BoolToToggleTextConverter}}"
                                        BackgroundColor="{Binding Activo, Converter={StaticResource BoolToToggleColorConverter}}"
                                        FontSize="12"
                                        HeightRequest="36"
                                        Padding="10,0"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ToggleActivoCommand}"
                                        CommandParameter="{Binding .}" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Grid Grid.Row="2"
              BackgroundColor="#191919"
              Padding="10"
              ColumnDefinitions="*,*,*,*">
            <Button Grid.Column="0"
                    Text="Inicio"
                    BackgroundColor="Transparent"
                    TextColor="#00FFFF"
                    Command="{Binding GoInicioCommand}" />
            <Button Grid.Column="1"
                    Text="Eventos"
                    BackgroundColor="Transparent"
                    TextColor="#FF10F0"
                    Command="{Binding GoEventsCommand}" />
            <Button Grid.Column="2"
                    Text="Artistas"
                    BackgroundColor="Transparent"
                    TextColor="#FFA500"
                    Command="{Binding GoArtistsCommand}" />
            <Button Grid.Column="3"
                    Text="Operación"
                    BackgroundColor="Transparent"
                    TextColor="#39FF14"
                    Command="{Binding GoSettingsCommand}" />
        </Grid>
    </Grid>
</ContentPage>
