<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="InventoryApp.Views.ProveedorFormPage"
             Title="{Binding Title}"
             BackgroundColor="{StaticResource Gray100}">
    <Grid RowDefinitions="*,Auto">

        <ScrollView Grid.Row="0">

            <VerticalStackLayout Padding="20" Spacing="12">

                <Border StrokeThickness="0"
                        BackgroundColor="#7C2D12"
                        StrokeShape="RoundRectangle 22"
                        Padding="18">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="🤝 Perfil del organizador" FontSize="22" FontAttributes="Bold" TextColor="White"/>
                        <Label Text="Mantén al día la especialidad y los canales de contacto de cada aliado."
                               FontSize="14"
                               TextColor="#FED7AA"/>
                    </VerticalStackLayout>
                </Border>

                <Label Text="Nombre" FontAttributes="Bold"/>
                <Entry Placeholder="Nombre del organizador"
                       Text="{Binding Nombre}"/>

                <Label Text="Especialidad" FontAttributes="Bold"/>
                <Entry Placeholder="Ej. Festivales, congresos, workshops"
                       Text="{Binding TipoProducto}"/>

                <Label Text="Teléfono" FontAttributes="Bold"/>
                <Entry Placeholder="Número de contacto"
                       Keyboard="Telephone"
                       Text="{Binding Telefono}"/>

                <Label Text="Correo electrónico" FontAttributes="Bold"/>
                <Entry Placeholder="correo@ejemplo.com"
                       Keyboard="Email"
                       Text="{Binding Email}"/>

                <Label Text="Estado" FontAttributes="Bold"/>
                <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                    <Label Grid.Column="0"
                           Text="{Binding Activo, Converter={StaticResource BoolToEstadoConverter}}"
                           VerticalOptions="Center"
                           FontSize="14"/>
                    <Switch Grid.Column="1"
                            IsToggled="{Binding Activo}"
                            VerticalOptions="Center"/>
                </Grid>

                <Button Text="💾 Guardar organizador"
                        Command="{Binding SaveCommand}"
                        HeightRequest="50"
                        BackgroundColor="#F97316"
                        TextColor="White"
                        Margin="0,10,0,0"/>

            </VerticalStackLayout>

        </ScrollView>

        <Grid Grid.Row="1"
              BackgroundColor="#0F172A"
              Padding="10"
              ColumnDefinitions="*,*,*,*">

            <Button Grid.Column="0"
                    Text="🏠 Inicio"
                    BackgroundColor="Transparent"
                    TextColor="#F8FAFC"
                    Command="{Binding GoInicioCommand}"/>

            <Button Grid.Column="1"
                    Text="🎟️ Eventos"
                    BackgroundColor="Transparent"
                    TextColor="#A78BFA"
                    Command="{Binding GoProductsCommand}"/>

            <Button Grid.Column="2"
                    Text="🤝 Organizadores"
                    BackgroundColor="Transparent"
                    TextColor="#FDBA74"
                    Command="{Binding GoProveedoresCommand}"/>

            <Button Grid.Column="3"
                    Text="✨ Marca"
                    BackgroundColor="Transparent"
                    TextColor="#22D3EE"/>

        </Grid>

    </Grid>
</ContentPage>
