<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="InventoryApp.Views.EventFormPage"
             Title="{Binding Title}">
    <Grid RowDefinitions="*,Auto">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="20" Spacing="12">
                <Label Text="Título" FontAttributes="Bold" />
                <Entry Placeholder="Nombre del concierto"
                       Text="{Binding Titulo}" />

                <Label Text="Artista" FontAttributes="Bold" />
                <Entry Placeholder="Banda o solista principal"
                       Text="{Binding Artista}" />

                <Label Text="Lugar" FontAttributes="Bold" />
                <Entry Placeholder="Arena, teatro o estadio"
                       Text="{Binding Lugar}" />

                <Label Text="Ciudad" FontAttributes="Bold" />
                <Entry Placeholder="Ciudad del evento"
                       Text="{Binding Ciudad}" />

                <Label Text="Fecha" FontAttributes="Bold" />
                <DatePicker Date="{Binding FechaEvento}" />

                <Label Text="Precio base" FontAttributes="Bold" />
                <Entry Placeholder="0"
                       Keyboard="Numeric"
                       Text="{Binding PrecioEntrada}" />

                <Label Text="Capacidad" FontAttributes="Bold" />
                <Entry Placeholder="0"
                       Keyboard="Numeric"
                       Text="{Binding Capacidad}" />

                <Label Text="Estado" FontAttributes="Bold" />
                <Picker ItemsSource="{Binding EstadoOptions}"
                        SelectedItem="{Binding Estado}" />

                <Label Text="Descripción" FontAttributes="Bold" />
                <Editor Placeholder="Resumen del concierto, logística o promoción"
                        HeightRequest="110"
                        Text="{Binding Descripcion}" />

                <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                    <Label Text="Marcar como destacado" VerticalOptions="Center" />
                    <Switch Grid.Column="1" IsToggled="{Binding Destacado}" />
                </Grid>

                <Button Text="💾 Guardar evento"
                        Command="{Binding SaveCommand}"
                        HeightRequest="50"
                        Margin="0,10,0,0" />
            </VerticalStackLayout>
        </ScrollView>

        <Grid Grid.Row="1"
              BackgroundColor="#191919"
              Padding="10"
              ColumnDefinitions="*,*,*,*">
            <Button Grid.Column="0"
                    Text="Inicio"
                    BackgroundColor="Transparent"
                    TextColor="#00FFFF"
                    Command="{Binding GoInicioCommand}" />
            <Button Grid.Column="1"
                    Text="Eventos"
                    BackgroundColor="Transparent"
                    TextColor="#FF10F0"
                    Command="{Binding GoEventsCommand}" />
            <Button Grid.Column="2"
                    Text="Artistas"
                    BackgroundColor="Transparent"
                    TextColor="#FFA500"
                    Command="{Binding GoArtistsCommand}" />
            <Button Grid.Column="3"
                    Text="Operación"
                    BackgroundColor="Transparent"
                    TextColor="#39FF14"
                    Command="{Binding GoSettingsCommand}" />
        </Grid>
    </Grid>
</ContentPage>
