<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="InventoryApp.Views.DashboardPage"
             Title="Inicio">

    <Grid RowDefinitions="*,Auto">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="24" Spacing="18">
                <Border Padding="20" StrokeShape="RoundRectangle 18" BackgroundColor="#121A2A">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="ConcertFlow"
                               FontSize="30"
                               FontAttributes="Bold"
                               TextColor="White" />
                        <Label Text="Administra conciertos, artistas y operación desde una sola app."
                               TextColor="#D7E3FF" />
                        <Label Text="Próximo evento"
                               FontSize="12"
                               TextColor="#90B4FF" />
                        <Label Text="{Binding ProximoEvento}"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="White" />
                    </VerticalStackLayout>
                </Border>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="12" RowDefinitions="Auto,Auto" RowSpacing="12">
                    <Border Grid.Row="0" Grid.Column="0" Padding="16" StrokeShape="RoundRectangle 16">
                        <VerticalStackLayout>
                            <Label Text="Eventos" FontSize="14" TextColor="Gray" />
                            <Label Text="{Binding TotalEventos}" FontSize="28" FontAttributes="Bold" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="1" Padding="16" StrokeShape="RoundRectangle 16">
                        <VerticalStackLayout>
                            <Label Text="Destacados" FontSize="14" TextColor="Gray" />
                            <Label Text="{Binding EventosDestacados}" FontSize="28" FontAttributes="Bold" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Row="1" Grid.ColumnSpan="2" Padding="16" StrokeShape="RoundRectangle 16">
                        <VerticalStackLayout>
                            <Label Text="Artistas activos" FontSize="14" TextColor="Gray" />
                            <Label Text="{Binding ArtistasActivos}" FontSize="28" FontAttributes="Bold" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <Button Text="🎫 Gestionar eventos"
                        Command="{Binding GoEventsCommand}"
                        HeightRequest="52" />

                <Button Text="🎤 Gestionar artistas"
                        Command="{Binding GoArtistsCommand}"
                        HeightRequest="52" />
            </VerticalStackLayout>
        </ScrollView>

        <Grid Grid.Row="1"
              BackgroundColor="#191919"
              Padding="10"
              ColumnDefinitions="*,*,*,*">
            <Button Grid.Column="0"
                    Text="Inicio"
                    BackgroundColor="Transparent"
                    TextColor="#00FFFF"
                    Command="{Binding GoInicioCommand}" />
            <Button Grid.Column="1"
                    Text="Eventos"
                    BackgroundColor="Transparent"
                    TextColor="#FF10F0"
                    Command="{Binding GoEventsCommand}" />
            <Button Grid.Column="2"
                    Text="Artistas"
                    BackgroundColor="Transparent"
                    TextColor="#FFA500"
                    Command="{Binding GoArtistsCommand}" />
            <Button Grid.Column="3"
                    Text="Operación"
                    BackgroundColor="Transparent"
                    TextColor="#39FF14"
                    Command="{Binding GoSettingsCommand}" />
        </Grid>
    </Grid>
</ContentPage>
