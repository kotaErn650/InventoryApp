<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="InventoryApp.Views.ProductsPage"
             Title="Eventos"
             BackgroundColor="{StaticResource Gray100}">

    <Grid RowDefinitions="Auto,*,Auto">

        <Button Grid.Row="0"
                Text="➕ Nuevo evento"
                Command="{Binding NewCommand}"
                BackgroundColor="#7C3AED"
                TextColor="White"
                Margin="15,14,15,10"/>

        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Products}"
                        Margin="12,0">

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,6"
                            Padding="16"
                            BackgroundColor="White"
                            Stroke="#E2E8F0"
                            StrokeShape="RoundRectangle 18">

                        <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="*,Auto,Auto">

                            <Label Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                                   Text="{Binding Nombre}"
                                   FontSize="19"
                                   FontAttributes="Bold"/>

                            <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                                   Text="{Binding Descripcion}"
                                   FontSize="13"
                                   TextColor="#64748B"/>

                            <Label Grid.Row="2" Grid.Column="0"
                                   Text="{Binding Precio, StringFormat='🎫 Entrada: ${0:N0}'}"
                                   FontSize="14"/>

                            <Label Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                                   Text="{Binding Stock, StringFormat='👥 Cupos: {0}'}"
                                   FontSize="14"
                                   HorizontalOptions="End"/>

                            <Label Grid.Row="3" Grid.Column="0"
                                   Text="{Binding Activo, Converter={StaticResource BoolToEstadoConverter}}"
                                   FontAttributes="Bold"
                                   FontSize="13"/>

                            <Button Grid.Row="3" Grid.Column="1"
                                    Text="✏️ Editar"
                                    FontSize="12"
                                    HeightRequest="36"
                                    Padding="10,0"
                                    BackgroundColor="#EDE9FE"
                                    TextColor="#5B21B6"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.EditCommand}"
                                    CommandParameter="{Binding .}"/>

                            <Button Grid.Row="3" Grid.Column="2"
                                    Text="{Binding Activo, Converter={StaticResource BoolToToggleTextConverter}}"
                                    FontSize="12"
                                    HeightRequest="36"
                                    Padding="10,0"
                                    BackgroundColor="{Binding Activo, Converter={StaticResource BoolToToggleColorConverter}}"
                                    TextColor="White"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DisableCommand}"
                                    CommandParameter="{Binding .}"/>

                        </Grid>

                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

        <Grid Grid.Row="2"
              BackgroundColor="#0F172A"
              Padding="10"
              ColumnDefinitions="*,*,*,*">

            <Button Grid.Column="0"
                    Text="🏠 Inicio"
                    BackgroundColor="Transparent"
                    TextColor="#F8FAFC"
                    Command="{Binding GoInicioCommand}"/>

            <Button Grid.Column="1"
                    Text="🎟️ Eventos"
                    BackgroundColor="Transparent"
                    TextColor="#A78BFA"
                    Command="{Binding GoProductsCommand}"/>

            <Button Grid.Column="2"
                    Text="🤝 Organizadores"
                    BackgroundColor="Transparent"
                    TextColor="#FDBA74"
                    Command="{Binding GoProveedoresCommand}"/>

            <Button Grid.Column="3"
                    Text="✨ Marca"
                    BackgroundColor="Transparent"
                    TextColor="#22D3EE"/>

        </Grid>

    </Grid>

</ContentPage>
