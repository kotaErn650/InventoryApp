<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="InventoryApp.MainPage"
             Title="ConcertFlow">

    <VerticalStackLayout Padding="24" Spacing="18" VerticalOptions="Center">
        <Label Text="ConcertFlow"
               FontSize="34"
               FontAttributes="Bold"
               HorizontalOptions="Center" />
        <Label Text="Centro de control para conciertos, artistas y operación del evento."
               HorizontalTextAlignment="Center"
               TextColor="Gray" />
        <Button Text="Ir al panel principal"
                Clicked="OnGoDashboardClicked"
                HeightRequest="50" />
        <Button Text="Abrir operación"
                Clicked="OnGoSettingsClicked"
                HeightRequest="50" />
    </VerticalStackLayout>
</ContentPage>
